# Salin berkas ini menjadi ".env" lalu isi nilainya. Jangan bagikan .env ke siapa pun.

# Nomor WhatsApp Anda, dengan kode negara, tanpa spasi. Contoh: +6281234567890
WHATSAPP_PHONE=+62

# --- Pilihan A: Fonnte (https://fonnte.com; berbayar, andal, aktivasi scan QR) ---
# Daftar -> tambah Device -> scan QR dari WhatsApp pengirim -> salin Token perangkat.
FONNTE_TOKEN=

# --- Pilihan B: CallMeBot (gratis) ---
# API key dari balasan bot CallMeBot (lihat README)
CALLMEBOT_APIKEY=

# --- Telegram (alternatif/pelengkap WhatsApp; resmi dan stabil) ---
# 1) Di Telegram cari @BotFather -> /newbot -> salin token.  2) Buka bot Anda, tekan Start.
# 3) Jalankan: python3 scan.py --telegram-id  -> salin angka chat_id ke bawah ini.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API key OpenAlex (GRATIS, sangat disarankan): tanpa ini anggaran harian dibagi per IP dan
# di GitHub Actions sering habis (HTTP 401). Daftar: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Opsional: API key Anthropic untuk ringkasan Bahasa Indonesia.
# Kosongkan bila ingin memakai abstrak asli saja (gratis).
ANTHROPIC_API_KEY=

# Opsional: alamat pembaca web (mis. GitHub Pages) agar tercantum di pesan WhatsApp
SITE_URL=
